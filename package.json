{
    "name": "@simcha-adler/feedback-ui",
    "version": "1.2.2",
    "description": "דיאלוגים וטוסטים לדפדפן. אפס תלויות runtime, RTL/LTR, ESM + IIFE.",
    "type": "module",
    "main": "./dist/feedback.js",
    "module": "./dist/feedback.js",
    "types": "./dist/feedback.d.ts",
    "style": "./dist/feedback.css",
    "unpkg": "./dist/feedback.min.js",
    "jsdelivr": "./dist/feedback.min.js",
    "exports": {
        ".": {
            "types": "./dist/feedback.d.ts",
            "import": "./dist/feedback.js",
            "default": "./dist/feedback.js"
        },
        "./style.css": "./dist/feedback.css",
        "./locales": {
            "types": "./dist/feedback.locales.d.ts",
            "import": "./dist/feedback.locales.js",
            "default": "./dist/feedback.locales.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "LICENSE",
        "CHANGELOG.md"
    ],
    "sideEffects": [
        "*.css"
    ],
    "scripts": {
        "build": "node scripts/build.js",
        "prepublishOnly": "npm run build"
    },
    "keywords": [
        "dialog",
        "toast",
        "modal",
        "rtl",
        "ltr",
        "hebrew",
        "feedback",
        "vanilla",
        "zero-dependency"
    ],
    "author": {
        "name": "שמחה אדלר"
    },
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "homepage": "https://simcha-adler.github.io/feedback-ui/demo/",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/simcha-adler/feedback-ui.git"
    },
    "bugs": {
        "url": "https://github.com/simcha-adler/feedback-ui/issues"
    },
    "devDependencies": {
        "esbuild": "^0.25.0"
    },
    "allowScripts": {
        "esbuild@0.25.12": true
    }
}
